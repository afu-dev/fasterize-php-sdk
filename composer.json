{
    "name": "afu-dev/fasterize-sdk",
    "description": "A PHP SDK Client For the Fasterize API",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "AFU\\FasterizeSdk\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Adrien Furnari",
            "email": "adrien@furnari.fr"
        }
    ],
    "require": {
        "psr/http-factory": "^1.1",
        "psr/http-client": "^1.0",
        "php": "^8.3",
        "php-http/client-common": "^2.7",
        "psr/http-client-implementation": "*",
        "php-http/discovery": "^1.20"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.4",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^7.3",
        "larapack/dd": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
